function actions.claimDaily(player: Player, data)
	local day = Config.dayNumber(os.time())
	if data.daily.last == day then
		notify(player, "Already claimed today - come back tomorrow!", "bad")
		return
	end
	local index = dailyIndex(data, day)
	local reward = Config.Daily[index]
	data.daily.last = day
	data.daily.streak = index
	data.diamonds += reward.diamonds
	local extras = ""
	if reward.boost then
		-- Like a boost from the shops (see purchase): powerup items for the backpack when Features/Powerups
		-- defines them, the boost itself right away when it does not.
		local powerup = Items.get(reward.boost) :: any
		if powerup and powerup.seconds then
			Game.items.give(player, reward.boost, math.ceil(reward.minutes * 60 / powerup.seconds))
			extras ..= ` and {powerup.name} ({reward.minutes} min) in your BACKPACK`
		else
			addBoost(data, reward.boost, reward.minutes)
			extras ..= ` and {Config.Boosts[reward.boost].name} for {reward.minutes} min`
		end
	end
	if reward.pet then
		addPet(player, data, reward.pet, true)
		refreshPets(player)
		extras ..= ` and a {Config.Pets[reward.pet].name}`
	end
	notify(player, `Day {index} reward: +{reward.diamonds} gems{extras}`, "good")
end

function actions.claimMission(player: Player, data, _state, missionId: unknown)
	local today = missions(data)
	for _, mission in Config.Missions do
		if mission.id == missionId then
			if today.claimed[mission.id] or (today.progress[mission.key] or 0) < mission.goal then
				return
			end
			today.claimed[mission.id] = true
			data.diamonds += mission.reward
			notify(player, `Mission complete! +{mission.reward} gems`, "good")
			return
		end
	end
end

-- Shared purchase path for the weekly diamond shop and the event candy shop.
local function purchase(player: Player, data, items, itemId: unknown, bought, currency: string)
	local item
	for _, candidate in items do
		if candidate.id == itemId then
			item = candidate
		end
	end
	if not item then
		return
	end
	local count = bought[item.id] or 0
	if count >= item.limit then
		notify(player, "Sold out", "bad")
		return
	end
	if item.kind == "slot" and data.extraSlots >= Config.MaxExtraSlots then
		notify(player, "Mini cannon slots are already maxed", "bad")
		return
	end
	if data[currency] < item.cost then
		notify(player, `Not enough {Config.CurrencyNames[currency]}`, "bad")
		return
	end
	data[currency] -= item.cost
	bought[item.id] = count + 1

	if item.kind == "pet" then
		addPet(player, data, item.pet, true)
		refreshPets(player)
	elseif item.kind == "boost" then
		-- A boost is sold as powerup items for the backpack (Features/Powerups), so the player picks the moment
		-- it starts. One item runs for powerup.seconds; they get as many as cover the minutes paid for.
		-- Without that feature there is no such item, and the boost starts at once as it always did.
		local powerup = Items.get(item.boost) :: any
		if powerup and powerup.seconds then
			Game.items.give(player, item.boost, math.ceil(item.minutes * 60 / powerup.seconds))
			notify(player, `Bought {item.name}! Use it from your BACKPACK`, "good")
			return
		end
		addBoost(data, item.boost, item.minutes)
	elseif item.kind == "slot" then
		data.extraSlots += 1
		refreshPets(player)
	elseif item.kind == "diamonds" then
		data.diamonds += item.amount
	end
	notify(player, `Bought {item.name}!`, "good")
end

function actions.buyWeekly(player: Player, data, _state, itemId: unknown)
	local week = Config.weekNumber(os.time())
	if data.weekly.week ~= week then
		data.weekly = { week = week, bought = {} }
	end
	purchase(player, data, Config.weeklyItems(week), itemId, data.weekly.bought, "diamonds")
end

function actions.buyEvent(player: Player, data, _state, itemId: unknown)
	if not Config.halloweenActive(os.time()) then
		notify(player, "The Halloween event has ended", "bad")
		return
	end
	purchase(player, data, Config.EventShop, itemId, data.event.bought, "candy")
end

local function onAction(player: Player, name: unknown, argument: unknown)
	local data, state = Data.get(player), states[player]
	if not data or not state or typeof(name) ~= "string" then
		return
	end
	local handler = actions[name]
	local now = os.clock()
	if not handler or now - state.lastAction < ACTION_COOLDOWN then
		return
	end
	state.lastAction = now
	fire("action", player, data, state, name)
	handler(player, data, state, argument)
	syncAll(player)
end

----------------------------------------------------------------------------------------------------
-- Players
----------------------------------------------------------------------------------------------------
local function takeSlot(player: Player): number
	for slot = 1, Layout.PLOT_COUNT do
		if not slots[slot] then
			slots[slot] = player
			return slot
		end
	end
	-- The server is over capacity for plots; share one rather than fail.
	return (player.UserId % Layout.PLOT_COUNT) + 1
end

local function newLeaderstats(player: Player)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local stats = {}
	-- Cannon Power outgrows any number value the player list can show: it is written out ("1.25Qa").
	for name, className in { Gems = "IntValue", Rebirths = "IntValue", ["Cannon Power"] = "StringValue" } do
		local value = Instance.new(className)
		value.Name = name
		value.Parent = folder
		stats[name] = value
	end
	folder.Parent = player
	return stats
end

-- A new character always starts on its own plot.
local function onCharacter(player: Player, character: Model)
	if not states[player] then
		return
	end
	character:WaitForChild("Humanoid", 10)
	character:WaitForChild("HumanoidRootPart", 10)
	task.wait()
	if character.Parent and states[player] then
		setPlace(player, "plot")
		sync(player)
	end
end

local function onPlayerAdded(player: Player)
	local data, loaded = Data.load(player)
	Passes.load(player)
	if not player.Parent then
		Passes.unload(player)
		Data.release(player)
		return
	end
	player.CameraMaxZoomDistance = MAX_CAMERA_ZOOM
	data.rebirths = math.clamp(math.floor(data.rebirths), 0, #Config.Worlds)
	data.speed = if data.speed == data.speed then math.clamp(math.floor(data.speed), 1, MAX_SPEED) else 1
	data.bestCleared = math.max(data.bestCleared, data.cleared)
	data.wave = math.clamp(data.wave, 1, math.min(data.cleared + 1, Config.TotalWaves))
	cleanTowers(data)

	local slot = takeSlot(player)
	local state = {
		player = player,
		slot = slot,
		plotCFrame = Layout.plotCFrame(slot),
		lastAction = 0,
		lastMeta = 0,
		equipped = {},
		place = "plot", -- "plot", "market" or "island" (see "Places")
		island = 0, -- which island, when on one
		inMarket = false, -- in the marketplace
		dps = 0, -- Cannon Power, as last synced
		failShare = 0, -- how much of the monster that last leaked had been shot off
		gemsOwed = 0, -- the part of a gem the `gems` modifiers have dropped so far
		dirty = true,
		metaDirty = true,
		leaderstats = newLeaderstats(player),
		-- the fight (see "Levels")
		clock = 0, -- seconds of simulation; what slowUntil and burnUntil are measured on
		busy = 0,
		nextId = 0,
		phase = "break",
		breakLeft = 0,
		failed = false,
		lives = Defense.lives,
		livesMax = Defense.lives,
		monsters = {},
		spawned = 0,
		spawnIn = 0,
		petOwed = 0,
		levelCoins = 0,
		plan = Config.levelPlan(data.wave),
		towers = {},
		towerList = {},
		towerNames = {},
		heroBase = 0,
		hp = 1,
		maxHp = 1,
	}
	states[player] = state
	released[slot] = nil
	Plots.claim(slot, player)
	Plots.setPads(slot, data.pads)
	refreshTowers(data, state)
	for _, tower in state.towerList do
		Plots.setTower(slot, tower.pad, tower.kind, tower.level)
	end
	refreshPets(player)
	startLevel(player, data, state)
	Game.setMeta(player, "items", data.items)
	fire("ready", player, data, state)
	syncAll(player)
	if not loaded then
		notify(player, "Save data could not load - progress this session will not save.", "bad")
	end
	if data.bestCleared == 0 and data.totalKills == 0 then
		notify(player, `Welcome to {Config.GameName}! Your cannon shoots by itself. Walk up to it and press UPGRADE to get further.`, "info")
	end

	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		onCharacter(player, player.Character)
	end
end

-- power: the player's Cannon Power, for its board. The save does not hold it, and by the time a leaving
-- player's save is written their session state is gone.
local function saveAndRelease(player: Player, power: number?)
	local data = Data.get(player)
	if data and Data.release(player) then
		Leaderboard.submit(player, data, { power = power or 0 })
	end
end

local function onPlayerRemoving(player: Player)
	local state = states[player]
	local power = if state then state.dps else nil
	if state then
		fire("leave", player, Data.get(player), state)
		if state.petsModel then
			state.petsModel:Destroy()
		end
		if slots[state.slot] == player then
			slots[state.slot] = nil
			Plots.release(state.slot)
			released[state.slot] = os.clock() + RELEASE_SECONDS
		end
		states[player] = nil
	end
	Passes.unload(player)
	saveAndRelease(player, power)
end

----------------------------------------------------------------------------------------------------
-- Plug-in API for features (src/server/Features). Documented in docs/ARCHITECTURE.md.
----------------------------------------------------------------------------------------------------
Game.random = rng
Game.notify = notify
Game.sync = syncAll

-- Adjusts a derived number: fn(player, data, state, value) -> value. The kinds, and what `value` starts as:
--   perClick / power   the multiplier on all tower and mini cannon damage (mini cannons x veteran x rebirths x boosts)
--   damage             one shot's damage, from a tower or a mini cannon
--   bossDamage         multiplier on every shot on a boss level (1)
--   towerRate          multiplier on every tower's shots per second (1)
--   towerRange         multiplier on every tower's range (1)
--   coins              multiplier on the coins of every kill
--   upgradeCost        multiplier on the price of tower upgrades (1; under 1 is a discount)
--   heal               share of max HP every monster of the level heals per second
--   monsterSpeed       multiplier on how fast monsters walk (1)
--   lives              the lives a level starts with (Config.Defense.lives); read when a level starts
--   autoShots          mini cannon shots per second, all together
--   petShots           multiplier on that (1)
--   petRange           multiplier on how far from the player their mini cannons shoot (1; Config.Defense.petRange)
--   luck               luck when hatching (1, or the pass's 3)
--   crateDrops         multiplier on crate drop chances (1). The core does not use it: Game.value(player, kind)
--   gems               gems a defeated boss drops (0). The core pays whole gems and carries the rest over
--   equipSlots         how many mini cannons can be equipped (the base, the weekly shop's slots, passes). A
--                      feature that changes what it gives calls Game.refreshPets(player)
-- label is what the STATS window calls this source (Game.breakdown): a string, or a function(player, data,
-- state) -> string or nil, nil meaning "not active right now". Without one it is listed as "Other".
-- A label function may also answer a list of parts, { { label = string, weight = number } }, when the one
-- modifier stands for several sources: what it changed is then shared out by weight, one line per part.
function Game.modify(kind: string, fn, label: any?)
	local list = modifiers[kind]
	assert(list, `Game.modify: there is no modifier called "{kind}"`)
	assert(typeof(fn) == "function", "Game.modify: the modifier must be a function")
	table.insert(list, { fn = fn, label = label })
end

-- The number of that kind for this player right now, with every modifier and the core's limits: what the game
-- really applies. 0 until the player is ready. (`damage` has no value of its own: it is per shot.)
function Game.value(player: Player, kind: string): number
	assert(CORE[kind], `Game.value: there is no number called "{kind}"`)
	local data, state = Data.get(player), states[player]
	return if data and state then derived(kind, data, state) else 0
end

-- Where a number comes from, for the STATS window: { base, total, sources = { { label, value, mult, add } } }.
--   base     what it starts as, before any source       total   what the game applies (Game.value)
--   sources  one entry per source that changes it right now, in the order they apply: first the core's own
--            (mini cannons, the Veteran level, rebirths, boosts), then every modifier, one at a time.
--            value is the number after that source, mult what it multiplied it by (nil when it started from
--            0) and add what it added.
-- nil until the player is ready.
function Game.breakdown(player: Player, kind: string)
	local core = CORE[kind]
	assert(core, `Game.breakdown: there is no number called "{kind}"`)
	local data, state = Data.get(player), states[player]
	if not data or not state then
		return nil
	end
	local sources = {}
	local value = modified(kind, data, state, core.value(player, data, state, sources), sources)
	local base = if typeof(core.base) == "function" then core.base(state) else core.base
	return { base = base, total = core.finish(value), sources = sources }
end

-- event: ready, leave, shot, kill, waveCleared, hatch, tick, levelStart, levelFailed, leak or rebirth.
-- fn(player, data, state, ...).
function Game.on(event: string, fn)
	local list = hooks[event]
	assert(list, `Game.on: there is no event called "{event}"`)
	table.insert(list, fn)
end

function Game.data(player: Player)
	return Data.get(player)
end

function Game.state(player: Player)
	return states[player]
end

-- A toast for everyone on the server.
function Game.announce(text: string, kind: string?)
	notifyRemote:FireAllClients(text, kind or "info")
end

-- A feature's own client state: sent as the JSON attribute Meta_<key>, read on the client with State.feature(key).
function Game.setMeta(player: Player, key: string, value)
	player:SetAttribute("Meta_" .. key, HttpService:JSONEncode(value))
end

-- A message to a feature's client module: ctx.on(channel, handler) receives the arguments.
function Game.send(player: Player, channel: string, ...)
	featureRemote:FireClient(player, channel, ...)
end

function Game.sendAll(channel: string, ...)
	featureRemote:FireAllClients(channel, ...)
end

-- A feature's own saved table, kept under data.features[name]. Missing keys are filled from defaults.
function Game.feature(data, name: string, defaults)
	local saved = data.features[name]
	if typeof(saved) ~= "table" then
		saved = {}
		data.features[name] = saved
	end
	for key, value in defaults or {} do
		if saved[key] == nil then
			saved[key] = if typeof(value) == "table" then table.clone(value) else value
		end
	end
	return saved
end

-- Extra damage that needs no tower (an ability, a burn from a feature): it hits the lead monster, the one
-- furthest along the path, and what is left over after a kill carries into the next one, for at most
-- Config.MaxChainKills kills. It stays inside the level being fought.
function Game.damage(player: Player, amount: number)
	local data, state = Data.get(player), states[player]
	if not data or not state or not usable(amount) then
		return
	end
	state.busy += 1
	for _ = 1, Config.MaxChainKills do
		local monster = leadMonster(state)
		if not monster then
			break
		end
		local health = monster.hp
		hurt(player, data, state, monster, math.min(amount, health))
		amount -= health
		if amount <= 0 then
			break
		end
	end
	state.busy -= 1
	sweep(player, data, state)
end

-- The same amount to every living monster of the level being fought, each on its own (an ability that hits
-- the whole plot). Returns how many it hit.
function Game.damageAll(player: Player, amount: number): number
	local data, state = Data.get(player), states[player]
	if not data or not state or not usable(amount) then
		return 0
	end
	local hits = 0
	state.busy += 1
	for _, monster in state.monsters do
		if not monster.dead then
			hits += 1
			hurt(player, data, state, monster, amount)
		end
	end
	state.busy -= 1
	sweep(player, data, state)
	return hits
end

-- The living monster furthest along the path within `range` studs of the player's character, or nil: what
-- their mini cannons would shoot at. Nothing while the player is away from their plot or has no character.
-- range is the mini cannons' own when left out: Config.Defense.petRange times the `petRange` modifiers. The
-- monster is the core's own table: read it, and hurt it with Game.hurt.
function Game.leadNear(player: Player, range: number?)
	local state = states[player]
	if not state or state.place ~= "plot" then
		return nil
	end
	local x, z = characterSpot(player, state)
	if not x or not z then
		return nil
	end
	local data = Data.get(player)
	local reach = range or (Defense.petRange * (if data then derived("petRange", data, state) else 1))
	return leadWithin(state, x, z, reach * reach)
end

-- Damage to one monster of the player's level (one from state.monsters, or from Game.leadNear). Nothing
-- carries over: what is left after the kill is lost. Returns whether it was dealt.
function Game.hurt(player: Player, monster, amount: number): boolean
	local data, state = Data.get(player), states[player]
	if not data or not state or typeof(monster) ~= "table" or monster.dead or not usable(amount) then
		return false
	end
	if not table.find(state.monsters, monster) then
		return false
	end
	state.busy += 1
	hurt(player, data, state, monster, amount)
	state.busy -= 1
	sweep(player, data, state)
	return true
end

-- One mini cannon shot (a "hero shot") at the lead monster, wherever the player is: through the `damage`
-- modifiers and the `shot` hook, like the ones the mini cannons fire themselves. For powerups and the like.
-- The second argument was "manual" in the clicker; nothing is manual any more and it is ignored.
function Game.shoot(player: Player, _manual: boolean?)
	local data, state = Data.get(player), states[player]
	if not data or not state then
		return
	end
	local target = leadMonster(state)
	if target then
		state.busy += 1
		shoot(player, data, state, target, state.heroBase * powerMult(data, state), "pet", nil)
		state.busy -= 1
		sweep(player, data, state)
	end
end

-- The multiplier on all the player's damage right now, with every `perClick` / `power` modifier: mini
-- cannons, the Veteran level, rebirths, boosts, features. The client reads it as PowerMult. 0 until the player is ready.
function Game.perClick(player: Player): number
	local data, state = Data.get(player), states[player]
	return if data and state then powerMult(data, state) else 0
end
Game.power = Game.perClick

-- The damage of one mini cannon shot right now, through the `bossDamage` and `damage` modifiers. The shot hooks (a crit, an
-- ammo type) are not run. For a feature that fires shots of its own and pays them with Game.damage.
-- 0 until the player is ready.
function Game.shotDamage(player: Player): number
	local data, state = Data.get(player), states[player]
	return if data and state then shotValue(data, state, state.heroBase * powerMult(data, state)) else 0
end

-- Stackable items (powerups, ammo, crates ...), defined in the shared Items registry and kept as data.items[id] = count.
Game.items = {}

function Game.items.count(data, id: string): number
	return data.items[id] or 0
end

function Game.items.give(player: Player, id: string, amount: number?): boolean
	local data = Data.get(player)
	if not data or not Items.get(id) then
		return false
	end
	data.items[id] = (data.items[id] or 0) + (amount or 1)
	Game.setMeta(player, "items", data.items)
	return true
end

-- Takes the items only if the player has that many. Returns whether it did.
function Game.items.take(player: Player, id: string, amount: number?): boolean
	local data = Data.get(player)
	local count = amount or 1
	if not data or (data.items[id] or 0) < count then
		return false
	end
	local left = data.items[id] - count
	data.items[id] = if left > 0 then left else nil
	Game.setMeta(player, "items", data.items)
	return true
end

-- What happens when an item is used from the backpack: handler(player, data, state, def) -> true to consume one.
-- key is an item id, or a category to handle every item in it.
local itemUses = {}
function Game.onUse(key: string, handler)
	itemUses[key] = handler
end

function actions.useItem(player: Player, data, state, itemId: unknown)
	local def = if typeof(itemId) == "string" then Items.get(itemId) else nil
	if not def or (data.items[itemId] or 0) < 1 then
		return
	end
	local handler = itemUses[itemId] or itemUses[def.category]
	if handler and handler(player, data, state, def) then
		Game.items.take(player, itemId :: string, 1)
	end
end

-- Mini cannons. Every change re-picks the equipped ones and rebuilds their models.
Game.pets = {}

function Game.pets.count(data, id: string): number
	local count = 0
	for _, other in data.pets do
		if other == id then
			count += 1
		end
	end
	return count
end

-- force keeps it even when storage is full (it replaces the weakest). Returns whether it was kept.
function Game.pets.add(player: Player, id: string, force: boolean?): boolean
	local data, state = Data.get(player), states[player]
	if not data or not state or not Config.Pets[id] then
		return false
	end
	local kept = addPet(player, data, id, force)
	refreshPets(player)
	state.metaDirty = true
	return kept
end

-- Removes that many only if the player owns them. Returns whether it did.
function Game.pets.remove(player: Player, id: string, amount: number?): boolean
	local data, state = Data.get(player), states[player]
	local left = amount or 1
	if not data or not state or Game.pets.count(data, id) < left then
		return false
	end
	for index = #data.pets, 1, -1 do
		if left > 0 and data.pets[index] == id then
			table.remove(data.pets, index)
			left -= 1
		end
	end
	refreshPets(player)
	state.metaDirty = true
	return true
end

-- Trades the mini cannons in `give` (a list of ids; the same id may be in it more than once) for the one
-- mini cannon `get`, in one step: a fusion, or an enchantment (one for one). Nothing happens unless the
-- player owns every one of them and `get` exists. The new one takes the place of the first: the list never
-- grows, so, unlike Game.pets.add, this can never push another mini cannon out of a full storage.
-- Returns whether it was done.
function Game.pets.swap(player: Player, give: { string }, get: string): boolean
	local data, state = Data.get(player), states[player]
	if not data or not state or typeof(give) ~= "table" or #give < 1 or typeof(get) ~= "string" or not Config.Pets[get] then
		return false
	end
	local places, taken = {}, {}
	for _, id in give do
		local found = nil
		for index, other in data.pets do
			if other == id and not taken[index] then
				found = index
				break
			end
		end
		if not found then
			return false
		end
		taken[found] = true
		table.insert(places, found)
	end
	data.pets[places[1]] = get
	taken[places[1]] = nil
	for index = #data.pets, 1, -1 do
		if taken[index] then
			table.remove(data.pets, index)
		end
	end
	refreshPets(player)
	state.metaDirty = true
	return true
end

-- Picks the equipped mini cannons again and rebuilds their models: for a feature whose `equipSlots` modifier
-- just changed what it gives (a new slot is filled at once).
function Game.refreshPets(player: Player)
	local state = states[player]
	if state and Data.get(player) then
		refreshPets(player)
		state.metaDirty = true
	end
end

-- Timed boosts, kept as data.boosts[id] = the unix time it runs out. The client reads them from State.meta.boosts.
Game.boosts = { active = boostActive }

function Game.boosts.add(player: Player, id: string, seconds: number)
	local data, state = Data.get(player), states[player]
	if data and state then
		data.boosts[id] = math.max(os.time(), data.boosts[id] or 0) + seconds
		state.dirty = true
		state.metaDirty = true
	end
end

function Game.boosts.remaining(data, id: string): number
	return math.max(0, (data.boosts[id] or 0) - os.time())
end

-- Robux developer products: Game.products[productId] = function(player) -> true once the purchase is granted.
Game.products = {}

function Game.promptProduct(player: Player, productId: number)
	MarketplaceService:PromptProductPurchase(player, productId)
end

local function processReceipt(receipt): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local data = player and Data.get(player)
	local handler = Game.products[receipt.ProductId]
	if not player or not data or not handler then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(data.receipts, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local ok, granted = pcall(handler, player)
	if not ok or not granted then
		if not ok then
			warn(`[Game] product {receipt.ProductId} failed: {granted}`)
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(data.receipts, receipt.PurchaseId)
	if #data.receipts > MAX_RECEIPTS then
		table.remove(data.receipts, 1)
	end
	syncAll(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- Studio-only cheat for testing: Remotes.Debug:FireServer("coins", 1e6), or ("wave", 50) to jump ahead.
local function enableDebug()
	newRemote("Debug").OnServerEvent:Connect(function(player: Player, field: unknown, value: unknown)
		local data, state = Data.get(player), states[player]
		if not data or not state or typeof(field) ~= "string" or typeof(value) ~= "number" or value ~= value then
			return
		end
		if string.sub(field, 1, 5) == "pass:" then
			-- e.g. Debug:FireServer("pass:tripleHatch", 1) gives the pass, 0 takes it away
			Passes.setForTesting(player, string.sub(field, 6), value ~= 0)
			return
		end
		if field == "wave" then
			data.wave = math.clamp(math.floor(value), 1, Config.TotalWaves)
			data.cleared = math.max(data.cleared, data.wave - 1)
			data.bestCleared = math.max(data.bestCleared, data.cleared)
			startLevel(player, data, state)
		elseif field == "towers" then
			-- e.g. Debug:FireServer("towers", 120) puts every tower the player has at level 120
			for _, tower in data.towers do
				tower.level = math.clamp(math.floor(value), 1, Config.TowerMaxLevel)
			end
			refreshTowers(data, state)
			for _, tower in state.towerList do
				Plots.setTower(state.slot, tower.pad, tower.kind, tower.level)
			end
		elseif string.sub(field, 1, 4) == "pet:" then
			-- e.g. Debug:FireServer("pet:wooden", 27) gives 27 Mini Wooden Cannons: enough to fuse a Diamond one.
			-- An enchanted id works too: "pet:wooden~sharp3"
			local id = string.sub(field, 5)
			if Config.Pets[id] then
				for _ = 1, math.min(value, 100) do
					addPet(player, data, id, true)
				end
				refreshPets(player)
			end
		elseif string.sub(field, 1, 5) == "item:" then
			-- e.g. Debug:FireServer("item:power2x", 5) gives 5 of that backpack item
			Game.items.give(player, string.sub(field, 6), math.clamp(math.floor(value), 1, 1000))
		elseif typeof(data[field]) == "number" then
			data[field] = value
		end
		syncAll(player)
	end)
end

-- Connects a prompt, or every prompt in a table (as keys or as values), to handler(player).
local function eachPrompt(prompts: any, connect: (ProximityPrompt) -> ())
	if typeof(prompts) == "Instance" then
		connect(prompts)
	elseif typeof(prompts) == "table" then
		for key, value in prompts do
			if typeof(key) == "Instance" then
				connect(key)
			elseif typeof(value) == "Instance" then
				connect(value)
			end
		end
	end
end

function Game.start()
	if RunService:IsStudio() then
		enableDebug()
	end
	actionRemote.OnServerEvent:Connect(onAction)
	MarketplaceService.ProcessReceipt = processReceipt

	-- Prompts: egg stands hatch, the marketplace's gate sends the player back to their plot, and the plots'
	-- own gate (Plots.marketPrompt, when the plot builder made one) sends them to the marketplace.
	-- Pad prompts need nothing here: the client opens the tower window and asks through the actions above.
	local function onPrompt(player: Player, handler)
		local data, state = Data.get(player), states[player]
		local now = os.clock()
		if not data or not state or now - state.lastAction < ACTION_COOLDOWN then
			return
		end
		state.lastAction = now
		fire("action", player, data, state, "prompt")
		handler(player, data, state)
		syncAll(player)
	end
	for prompt, eggId in Marketplace.eggPrompts do
		local egg = Config.EggById[eggId]
		prompt.Triggered:Connect(function(player: Player)
			onPrompt(player, function(_, data, state)
				hatchEgg(player, data, state, egg, 1)
			end)
		end)
	end
	for prompt, eggId in Marketplace.tripleEggPrompts do
		local egg = Config.EggById[eggId]
		prompt.Triggered:Connect(function(player: Player)
			onPrompt(player, function(_, data, state)
				hatchTriple(player, data, state, egg)
			end)
		end)
	end
	eachPrompt(Marketplace.returnPrompt, function(prompt)
		prompt.Triggered:Connect(function(player: Player)
			onPrompt(player, function()
				setPlace(player, "plot")
			end)
		end)
	end)
	eachPrompt(Game.homePrompts, function(prompt)
		prompt.Triggered:Connect(function(player: Player)
			onPrompt(player, function()
				setPlace(player, "plot")
			end)
		end)
	end)
	eachPrompt((Plots :: any).marketPrompt, function(prompt)
		prompt.Triggered:Connect(function(player: Player)
			onPrompt(player, function()
				setPlace(player, "market")
			end)
		end)
	end)

	-- A pass was bought (or toggled in Studio): slots and odds may have changed.
	Passes.changed:Connect(function(player: Player)
		if states[player] and Data.get(player) then
			refreshPets(player)
			syncAll(player)
			notify(player, "Game pass unlocked!", "good")
		end
	end)
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	local simOwed, sinceHook, sinceSync, sinceField = 0, 0, 0, 0
	RunService.Heartbeat:Connect(function(dt: number)
		-- The fight runs in fixed steps, however long a frame took. A server that falls behind does not try to
		-- catch up more than MAX_STEPS at once: the monsters walk slower instead.
		simOwed = math.min(simOwed + dt, STEP * MAX_STEPS)
		while simOwed >= STEP do
			simOwed -= STEP
			for _, player in Players:GetPlayers() do
				-- The player's own game speed: their plot simply takes more steps.
				local data = Data.get(player)
				for _ = 1, if data then math.clamp(data.speed, 1, MAX_SPEED) else 1 do
					stepPlayer(player, STEP)
				end
			end
		end

		sinceHook += dt
		if sinceHook >= HOOK_SECONDS then
			for _, player in Players:GetPlayers() do
				local data, state = Data.get(player), states[player]
				if data and state then
					fire("tick", player, data, state, sinceHook)
					state.dirty = true -- boosts run out, features change multipliers
				end
			end
			sinceHook = 0
		end

		sinceField += dt
		if sinceField >= FIELD_SECONDS then
			sinceField = 0
			sendFields()
		end

		sinceSync += dt
		if sinceSync >= SYNC_SECONDS then
			sinceSync = 0
			local now = os.clock()
			for player, state in states do
				if state.dirty then
					sync(player)
				end
				if state.metaDirty and now - state.lastMeta >= META_SECONDS then
					syncMeta(player)
				end
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for _, player in Players:GetPlayers() do
				local data, state = Data.get(player), states[player]
				if data and Data.save(player) then
					Leaderboard.submit(player, data, { power = if state then state.dps else 0 })
				end
			end
		end
	end)

	-- Release (not just save) so PlayerRemoving does not write the same key a second time.
	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			local state = states[player]
			saveAndRelease(player, if state then state.dps else nil)
		end
	end)
end

return Game
