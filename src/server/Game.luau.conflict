-- Rebirth, the rare prestige (Config.Rebirth): allowed once the final boss of world (rebirths + 1) is beaten
-- in this run. It puts the levels, the coins, the pads and the towers back to a new save's, and keeps
-- everything else: mini cannons, gems, candy, items, boosts, what the features saved (mastery, enchants, the
-- story), the Veteran level and every unlock (bestCleared). It pays gems and adds tower damage for good.
-- The argument must be `true`: the WORLDS window sends it on the second, confirming press.
function actions.rebirth(player: Player, data, state, confirmed: unknown)
	if confirmed ~= true then
		return
	end
	local need = Config.rebirthWave(data.rebirths)
	if need > Config.TotalWaves then
		notify(player, "You have taken every rebirth there is", "info")
		return
	end
	if data.cleared < need then
		notify(player, `Beat {Config.Worlds[Config.worldOf(need)].finalBoss.name} ({Config.waveLabel(need)}) to rebirth`, "bad")
		return
	end

	for _, tower in state.towerList do
		Plots.setTower(state.slot, tower.pad, nil, nil)
	end
	data.rebirths += 1
	data.wave = Data.fresh("wave")
	data.cleared = Data.fresh("cleared")
	data.coins = Data.fresh("coins")
	data.pads = Data.fresh("pads")
	data.towers = Data.fresh("towers")
	data.autoAdvance = Data.fresh("autoAdvance")
	data.diamonds += Config.Rebirth.gems
	cleanTowers(data)

	state.towers = {} -- no cooldown carries over
	Plots.setPads(state.slot, data.pads)
	refreshTowers(data, state)
	for _, tower in state.towerList do
		Plots.setTower(state.slot, tower.pad, tower.kind, tower.level)
	end
	refreshPets(player) -- the set bonus goes by the towers' tier names
	startLevel(player, data, state)
	state.metaDirty = true

	local percent = math.floor((Config.rebirthMult(data.rebirths) - 1) * 100 + 0.5)
	notify(player, `REBIRTH {data.rebirths}! +{percent}% tower damage forever and +{Config.Rebirth.gems} gems. Back to {Config.waveLabel(1)}.`, "good")
	fire("rebirth", player, data, state)
	Game.send(player, "defense", "rebirth", data.rebirths)
end

